APP_NAME="SIMRS USU"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=simrs
DB_USERNAME=simrs_app
DB_PASSWORD=simrs_app
DB_SEARCH_PATH=sistem,public
DB_MIGRATOR_USERNAME=simrs_migrator
DB_MIGRATOR_PASSWORD=simrs_migrator

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
# SESSION_SECURE_COOKIE bawaannya true di luar APP_ENV=local; aplikasi menolak boot bila false.

# SPA (Vite dev server memproksi /api dan /sanctum ke backend)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autentikasi (PRD 14.2); bawaan di config/autentikasi.php
# AUTENTIKASI_KUNCI_MAKS_GAGAL=5
# AUTENTIKASI_KUNCI_DURASI_MENIT=15
# AUTENTIKASI_BATAS_DIAM_MENIT=15
# AUTENTIKASI_BATAS_DIAM_PERANGKAT_TERDAFTAR_MENIT=60
# AUTENTIKASI_SANDI_CEK_HIBP=false
# MFA (PRD 10.3.2): CIDR jaringan RS, dipisah koma; akses dari luar wajib MFA. Kosong = semua wajib MFA.
# Lokal/CI hanya loopback. Produksi: isi jaringan RS yang sebenarnya.
AUTENTIKASI_MFA_JARINGAN_RS=127.0.0.1/32,::1/128
# AUTENTIKASI_MFA_PENERBIT="Nama RS"
# AUTENTIKASI_BATAS_PER_IP_PER_MENIT=60
# AUTENTIKASI_BATAS_PER_NAMA_PENGGUNA_PER_MENIT=10
# Reverse proxy di depan aplikasi (IP/CIDR, dipisah koma); kosong = tanpa proksi. Lihat config/jaringan.php.
PROKSI_TEPERCAYA=
# Sandi akun sintetis untuk db:seed (lokal/staging); kosong = dibuat acak dan dicetak sekali.
AKUN_SINTETIS_SANDI=
# Rahasia TOTP (Base32) akun sintetis contoh.mfa; kosong = dibuat acak dan dicetak sekali.
AKUN_SINTETIS_MFA_RAHASIA=

# Audit (ADR 0003); bawaan di config/audit.php
# AUDIT_ZONA_WAKTU=Asia/Jakarta
# AUDIT_PARTISI_BULAN_KE_DEPAN=3
# Produksi: arahkan ke penyimpanan terpisah yang tidak bisa ditimpa (mis. MinIO object lock).
# AUDIT_JANGKAR_DISK=local
# AUDIT_JANGKAR_DIREKTORI=audit/jangkar

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Valkey (kompatibel Redis, PRD 10.1); nama variabel tetap REDIS_* bawaan Laravel.
# Produksi memakai phpredis; predis hanya untuk lokal bila ekstensi tidak tersedia.
REDIS_CLIENT=predis
# Instans sesi dan antrean (noeviction), layanan `valkey` di docker-compose.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# Instans cache (allkeys-lru), layanan `valkey-cache`. Jangan diarahkan ke instans sesi (PRD 14.1.1 butir 6).
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
# REDIS_CACHE_PASSWORD=
# REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
