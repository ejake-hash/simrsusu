APP_NAME="Karsitara SIMRS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=simrs
DB_USERNAME=simrs_app
DB_PASSWORD=simrs_app
DB_SEARCH_PATH=sistem,public
DB_MIGRATOR_USERNAME=simrs_migrator
DB_MIGRATOR_PASSWORD=simrs_migrator
# Batas waktu membuka koneksi PostgreSQL, detik (PRD 14.1.1 butir 2; uji beban 1.12).
# DB_CONNECT_TIMEOUT=5

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
# SESSION_SECURE_COOKIE bawaannya true di luar APP_ENV=local; aplikasi menolak boot bila false.

# SPA (Vite dev server memproksi /api dan /sanctum ke backend)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Autentikasi (PRD 14.2); bawaan di config/autentikasi.php
# AUTENTIKASI_KUNCI_MAKS_GAGAL=5
# AUTENTIKASI_KUNCI_DURASI_MENIT=15
# AUTENTIKASI_BATAS_DIAM_MENIT=15
# AUTENTIKASI_BATAS_DIAM_PERANGKAT_TERDAFTAR_MENIT=60
# AUTENTIKASI_SANDI_CEK_HIBP=false
# MFA (PRD 10.3.2): CIDR jaringan RS, dipisah koma; akses dari luar wajib MFA, dan akun tanpa MFA
# tidak bisa mendaftar dari luar. Kosong = login web ditolak (503 konfigurasi_belum_lengkap); superadmin
# pertama dibuat dengan `php artisan akses:superadmin-pertama`.
# Lokal/CI hanya loopback. Produksi: isi jaringan RS yang sebenarnya.
AUTENTIKASI_MFA_JARINGAN_RS=127.0.0.1/32,::1/128
# AUTENTIKASI_MFA_PENERBIT="Nama RS"
# AUTENTIKASI_MFA_ULANG_MENIT=15
# AKSES_LABEL_MAKS_HARI=365
# AUTENTIKASI_BATAS_PER_IP_PER_MENIT=60
# AUTENTIKASI_BATAS_PER_NAMA_PENGGUNA_PER_MENIT=10
# Rate limit semua rute api/v1 (PRD 14.1.1); bawaan di config/rate_limit.php
# RATE_LIMIT_API_PER_PENGGUNA_PER_MENIT=120
# RATE_LIMIT_API_PER_IP_PER_MENIT=120
# RATE_LIMIT_LAYAR_KERJA_PER_PENGGUNA_PER_MENIT=600
# RATE_LIMIT_SIAP_PER_IP_PER_MENIT=60
# Reverse proxy di depan aplikasi (IP/CIDR, dipisah koma); kosong = tanpa proksi. Lihat config/jaringan.php.
TRUSTED_PROXIES=
# Sandi akun sintetis untuk db:seed (lokal/staging); kosong = dibuat acak dan dicetak sekali.
AKUN_SINTETIS_SANDI=
# Rahasia TOTP (Base32) akun sintetis contoh.mfa; kosong = dibuat acak dan dicetak sekali.
AKUN_SINTETIS_MFA_RAHASIA=
# Rahasia TOTP (Base32) akun sintetis contoh.superadmin; kosong = dibuat acak dan dicetak sekali.
AKUN_SINTETIS_SUPERADMIN_MFA_RAHASIA=
# Rahasia TOTP (Base32) akun sintetis contoh.superadmin.dua (e2e kontrol ganda 1.2d); kosong = acak, dicetak sekali.
AKUN_SINTETIS_SUPERADMIN_DUA_MFA_RAHASIA=
# Rahasia TOTP (Base32) akun sintetis contoh.sdm (e2e Data pegawai 1.8d); kosong = acak, dicetak sekali.
AKUN_SINTETIS_SDM_MFA_RAHASIA=
# Rahasia TOTP sintetis contoh.integrasi (tiket 1.9; Base32, kosong = acak dicetak sekali).
AKUN_SINTETIS_INTEGRASI_MFA_RAHASIA=
# PIN TTE sintetis (6 angka, tidak berurutan/berulang) untuk contoh.ttd dan contoh.superadmin.dua; kosong = acak, dicetak sekali.
AKUN_SINTETIS_TTD_PIN=

# Tanda tangan elektronik (config/ttd.php). TTD_KUNCI = kunci server `base64:<32 bita>` (lada PIN; simpan di vault,
# jangan di DB). Buat dengan: php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
# Kosong = TTE tidak bisa diaktifkan. Rotasi: kunci lama dipindah ke TTD_KUNCI_LAMA (dipisah koma).
TTD_KUNCI=
TTD_KUNCI_LAMA=
# TTD_MAKS_PIN_SALAH=5
# TTD_KUNCI_MENIT=15
# TTD_SESI_MENIT=15

# Instalasi (config/instalasi.php). Instalasi demo/pelatihan berisi data sintetis: pita "DEMO — data fiktif"
# di setiap layar (FR-54-10); ditetapkan saat pemasangan, bukan dari APP_ENV.
INSTALASI_DEMO=false
# INSTALASI_ZONA_WAKTU=Asia/Jakarta
# Berkas paket identitas (logo, motif, foto). Produksi: disk S3/MinIO; bawaan disk lokal privat.
# IDENTITAS_DISK=local
# IDENTITAS_BATAS_LOGO_KB=200
# IDENTITAS_BATAS_MOTIF_KB=500
# IDENTITAS_BATAS_FOTO_KB=2048
# Lokal/staging saja: folder paket identitas RS di LUAR repo (profil.json + logo/motif/foto) yang dipasang
# `php artisan db:seed` (PaketIdentitasContohSeeder; format di docs/brand/README.md). Kosong = identitas netral.
PAKET_IDENTITAS_CONTOH_DIR=

# Audit (ADR 0003); bawaan di config/audit.php
# AUDIT_ZONA_WAKTU=Asia/Jakarta
# Baris per jendela audit:verifikasi-rantai (tiap query di bawah statement_timeout 5 detik).
# AUDIT_VERIFIKASI_JENDELA=50000
# AUDIT_PARTISI_BULAN_KE_DEPAN=3
# Produksi: arahkan ke penyimpanan terpisah yang tidak bisa ditimpa (mis. MinIO object lock).
# AUDIT_ANCHOR_DISK=local
# AUDIT_ANCHOR_DIREKTORI=audit/anchor

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Valkey (kompatibel Redis, PRD 10.1); nama variabel tetap REDIS_* bawaan Laravel.
# Produksi memakai phpredis; predis hanya untuk lokal bila ekstensi tidak tersedia.
REDIS_CLIENT=predis
# Instans sesi dan queue (noeviction), layanan `valkey` di docker-compose.
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_DB=0
# Instans cache (allkeys-lru), layanan `valkey-cache`. Jangan diarahkan ke instans sesi (PRD 14.1.1 butir 6).
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
# REDIS_CACHE_PASSWORD=
# REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dokumen izin praktik pegawai (tiket 1.8d): disk privat dan batas ukuran.
# SDM_DOKUMEN_DISK=local
# SDM_DOKUMEN_BATAS_KB=5120
# SDM_IZIN_PRAKTIK_HARI_PERINGATAN=60

# Gateway integrasi (config/integrasi.php, tiket 1.9). KREDENSIAL_KUNCI = kunci khusus kredensial BPJS/SATUSEHAT
# `base64:<32 bita>` (K9; bukan APP_KEY; simpan di vault). Kosong = kredensial tidak bisa disimpan. Rotasi: kunci lama
# dipindah ke KREDENSIAL_KUNCI_LAMA (dipisah koma), lalu `php artisan integrasi:rotasi-kunci`.
KREDENSIAL_KUNCI=
KREDENSIAL_KUNCI_LAMA=
# Simulator dalam repo (K8): true di lokal/CI/staging tanpa kredensial; selalu mati di produksi.
INTEGRASI_SIMULATOR=false
# Alamat sistem luar per lingkungan (bawaan dari catatan lapangan, perlu verifikasi sebelum produksi).
# INTEGRASI_VCLAIM_SANDBOX=
# INTEGRASI_VCLAIM_PRODUKSI=
# INTEGRASI_APLICARES_SANDBOX=
# INTEGRASI_APLICARES_PRODUKSI=
# INTEGRASI_SATUSEHAT_SANDBOX=
# INTEGRASI_SATUSEHAT_PRODUKSI=
# INTEGRASI_LOG_HARI=90
