<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <!-- TTE (tiket 1.6): kunci server sintetis khusus tes dan KDF minimum agar tes cepat. -->
        <!-- PERINGATAN: TTD_KUNCI (dan KREDENSIAL_KUNCI) di sini nilai uji sintetis yang publik; DILARANG dipakai di server. -->
        <env name="TTD_KUNCI" value="base64:dGVzLXR0ZC1rdW5jaS1zZXJ2ZXItc2ludGV0aXMtMzI="/>
        <env name="TTD_KDF" value="minimum"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost:5173"/>
        <!-- Klien tes (127.0.0.1) di dalam jaringan RS; uji "dari luar" memakai REMOTE_ADDR lain. -->
        <env name="AUTENTIKASI_MFA_JARINGAN_RS" value="127.0.0.1/32,::1/128"/>
        <!-- Hanya untuk tes pemalsuan audit (RantaiAuditTest); sama dengan docker-compose dan CI. -->
        <env name="DB_SUPERUSER_USERNAME" value="postgres"/>
        <env name="DB_SUPERUSER_PASSWORD" value="postgres"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CACHE_LIMITER_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="simrs_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
