# Paket identitas CONTOH (RS USU) untuk pengembangan lokal saja; jangan dipakai di demo publik
# (PRD 3.4). Build produksi tanpa nilai ini tidak menampilkan kartu RS.
VITE_RS_NAMA="RS Pendidikan Prof. dr. Chairuddin P. Lubis USU"
VITE_RS_LOGO=/logo/rs-usu.png
# Motif dibuat ulang dari prototipe (docs/brand/motif-usu.svg); belum dicocokkan dengan file asli pedoman USU.
VITE_RS_MOTIF=/motif/usu.svg
# Unit pengelola akun di teks halaman masuk; kosong = "admin SIMRS".
# VITE_RS_UNIT_ADMIN="Instalasi SIMRS"
VITE_RS_KONTAK_ADMIN="ext. 1234"
